rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'alonso.nava086@gmail.com' ||
        (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isEmpleado() {
      return isSignedIn() && (
        request.auth.token.email == 'alonso.nava086@gmail.com' ||
        (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == 'empleado'))
      );
    }

    // ── Colecciones públicas (lectura) ───────────────────────────
    match /categorias/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ingredientes/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /carnes/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /precios/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /populares/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Pedidos ──────────────────────────────────────────────────
    match /pedidos/{id} {
      allow create: if true;
      allow read, update: if isEmpleado();
      allow delete: if isAdmin();
    }

    // ── Gastos ───────────────────────────────────────────────────
    match /gastos/{id} {
      allow read, write: if isAdmin();
    }

    // ── Visitas ──────────────────────────────────────────────────
    match /visits/{id} {
      allow create: if true;
      allow read: if isEmpleado();
    }

    // ── Usuarios ─────────────────────────────────────────────────
    match /usuarios/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isSignedIn() && (request.auth.uid == uid || isAdmin() || request.auth.token.email == 'alonso.nava086@gmail.com');
    }
  }
}
